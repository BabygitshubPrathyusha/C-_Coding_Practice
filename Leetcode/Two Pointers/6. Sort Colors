// Approach 1
public class Solution {
    public void SortColors(int[] arr) {
        int c0 = 0; int c1 = 0; int c2 = 0;
        for(int i=0; i< arr.Length; i++){
        if (arr[i] == 0) { c0+=1; }
        else if (arr[i]== 1) { c1+=1; }
        else if (arr[i] == 2) { c2+=1; }
        }
        int indx=0;
        for(int i=0; i<c0; i++){arr[indx++] = 0;}
        for(int i=0; i<c1; i++){arr[indx++] = 1;}
        for(int i=0; i<c2; i++){arr[indx++] = 2;}
    }
}

