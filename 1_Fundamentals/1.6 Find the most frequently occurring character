using System;
using System.Collections.Generic;

class HelloWorld
{
    static void Main()
    {
        string input = "aabbcdde";

        Dictionary<char, int> characterCount = new Dictionary<char, int>();

        // Count each character
        foreach (char character in input)
        {
            if (characterCount.ContainsKey(character))
            {
                characterCount[character]++;
            }
            else
            {
                characterCount[character] = 1;
            }
        }

        // Find the most frequently occurring character
        int maxCount = 0;
        char mostFrequentCharacter = '\0';

        foreach (var item in characterCount)
        {
            if (item.Value > maxCount)
            {
                maxCount = item.Value;
                mostFrequentCharacter = item.Key;
            }
        }

        Console.WriteLine(
            $"Most frequent character: {mostFrequentCharacter}, Count: {maxCount}");
    }
}
