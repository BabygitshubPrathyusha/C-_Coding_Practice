using System;
using System.Linq;
using System.Collections.Generic;

class HelloWorld
{
    static void Main()
    {
        string input = "aaabbc";
        string compressed = "";
        int count = 1;
        for (int i = 0; i < input.Length; i++)
        {
            if (i + 1 < input.Length && input[i] == input[i + 1])
            {
                count++;
            }
            else
            {
                compressed += input[i];
                compressed += count;
                count = 1;
            }
        }
        Console.WriteLine(compressed);
    }
}

// Output
// a3b2c1
