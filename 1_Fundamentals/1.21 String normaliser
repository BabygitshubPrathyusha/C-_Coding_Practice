using System;
using System.Collections.Generic;
using System.Text;

class HelloWorld
{
    static void Main()
    {
        string input = "   Hello   WORLD   hello   ";
        string expected = "hello world hello";

        // 1. Remove leading and trailing spaces
        string trimmedInput = input.Trim();

        // 2. Split into words
        string[] words = trimmedInput.Split(
            ' ',
            StringSplitOptions.RemoveEmptyEntries
        );

        // 3. Count word frequency
        Dictionary<string, int> wordCount =
            new Dictionary<string, int>(
                StringComparer.OrdinalIgnoreCase
            );

        // 4. Build normalized string efficiently
        StringBuilder normalized = new StringBuilder();

        foreach (string word in words)
        {
            // Add word to dictionary
            if (wordCount.ContainsKey(word))
            {
                wordCount[word]++;
            }
            else
            {
                wordCount[word] = 1;
            }

            // Build normalized string
            if (normalized.Length > 0)
            {
                normalized.Append(" ");
            }

            normalized.Append(word.ToLower());
        }

        // 5. Display normalized string
        Console.WriteLine($"Normalized: {normalized}");

        // 6. Display frequencies
        foreach (var item in wordCount)
        {
            Console.WriteLine($"{item.Key.ToLower()} → {item.Value}");
        }

        // 7. Compare strings using StringComparison
        bool isEqual = string.Equals(
            normalized.ToString(),
            expected,
            StringComparison.OrdinalIgnoreCase
        );

        Console.WriteLine($"Matches expected: {isEqual}");
    }
}

