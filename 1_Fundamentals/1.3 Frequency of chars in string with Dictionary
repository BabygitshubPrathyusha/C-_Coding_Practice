
using System.Collections.Generic;
using System;
class HelloWorld {
  static void Main() {
      // Uisng string iterations
      string s ="madam"; 
      Dictionary<char, int> dict = new Dictionary<char, int>();
      foreach (char ch in s)
        {
            if (dict.ContainsKey(ch))
            {
                dict[ch]++;
            }
            else
            {
                dict[ch] = 1;
            }
        }
      foreach (var x in dict)
        {
            Console.WriteLine($"{x.Key} = {x.Value}");
        }
  }
}
